extends ../../layouts/default.pug
include ../../mixins/filter-status.pug
include ../../mixins/search.pug
include ../../mixins/pagination.pug
include ../../mixins/form-change-multi.pug
include ../../mixins/moment.pug
block main 
    if(role.permissions.includes("products_restore"))
        h1 Thùng rác

        .card.mb-3 
            .card-header Bộ lọc và tìm kiếm 
            .card-body
                .row
                    .col-6
                        +filter-status(filterStatus)
                    .col-6 
                        +search(keyword)

        .card.mb-3 
            .card-header Danh sách sản phẩm bị xoá
            .card-body
                //- +form-change-multi(`${prefixAdmin}/products/change-multi?_method=PATCH`)
                table(
                    class="table table-hover table-sm"
                    checkbox-multi 
                )
                    thead 
                        tr 
                            th 
                                input(type="checkbox" name="checkall")
                            th STT 
                            th Hình ảnh 
                            th Tiêu đề
                            th Giá
                            th Trạng thái 
                            th Hành động
                            th Người xoá
                    tbody
                        each item, index in products 
                            tr 
                                td  
                                    input(
                                        type="checkbox"
                                        name="id"
                                        value=item.id
                                    )
                                td #{index + 1} 
                                td 
                                    img(
                                        src=item.thumbnail,
                                        alt=item.title
                                        width="100px"
                                        height="auto"
                                    )
                                td #{item.title}
                                td #{item.price}$
                                td 
                                    if(item.status == "active")
                                        a(
                                            href="javascript:;"
                                            data-status=item.status 
                                            data-id=item.id 
                                            button-change-status
                                            class="badge text-bg-success text-decoration-none"
                                        ) Hoạt động
                                    else 
                                        a(
                                            href="javascript:;"
                                            data-status=item.status 
                                            data-id=item.id 
                                            button-change-status 
                                            class="badge text-bg-danger text-decoration-none"
                                        ) Dừng hoạt động

                                td 
                                    button(
                                        class="btn btn-warning btn-sm"
                                        button-restore
                                        data-restore-id=item.id
                                    ) Restore
                                td 
                                    span #{item.accountFullNameDelete}
                                    span 
                                        +formatDateTime(item.deletedBy.deletedAt)

        +pagination(pagination)

        form(
            action=""
            method="POST"
            id="form-change-status"
            data-path=`${prefixAdmin}/products/change-status`
        ) 

        form(
            action=""
            method="POST"
            id="form-restore-item"
            data-path=`${prefixAdmin}/products/restore`
        ) 


        script(src="/admin/js/product.js") 
