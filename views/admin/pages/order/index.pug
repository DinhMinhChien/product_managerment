doctype html
html
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title Danh sách đơn hàng
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css")
    link(rel="stylesheet", href="/admin/css/order_style.css")
  body
    .container.mt-4
      h1.mb-3 Danh sách tất cả đơn hàng
      p.text-muted Quản lý toàn bộ đơn hàng của cửa hàng

      table.table.table-striped.table-hover
        thead
          tr
            th Mã đơn
            th Khách hàng
            th SĐT
            th Địa chỉ
            th Sản phẩm
            th Tổng tiền
            th Thời gian
        tbody
          each order in orders
            tr
              td.fw-bold= order._id
              td.fw-bold= order.userInfo.fullName
              td.fw-bold= order.userInfo.phone
              td.fw-bold= order.userInfo.address
              td.fw-bold
                each p in order.products
                  div #{p.product_title} - SL: #{p.quantity} - Giá: #{p.price}
              td.fw-bold #{order.total.toLocaleString()} $
              td.fw-bold= new Date(order.createdAt).toLocaleString()

      a.btn.btn-primary.mt-3(href="/admin/dashboard") ← Quay lại Dashboard
