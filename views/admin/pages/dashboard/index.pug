extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
    +alert-success(5000)
    .container-fluid.p-4
        .row.mb-3
            .col-8
                h1.mb-0 Admin Dashboard

        .row.g-3
            .col-12.col-md-3
                .card.kpi-card.p-3
                    h6.mb-1 Tổng đơn hàng
                    h4#total-orders.mb-0 #{totalOrders}

            .col-12.col-md-3
                .card.kpi-card.p-3
                    h6.mb-1 Doanh thu (tháng)
                    h4#total-revenue.mb-0 #{totalRevenue.toLocaleString()} $

        .row.mt-4
            .col-lg-8
                .card.mb-3
                    .card-body
                        h5.card-title Đơn hàng mới nhất
                        table.table.table-hover
                            thead
                                tr
                                    th Mã
                                    th Khách hàng
                                    th Tổng tiền
                                    th Trạng thái
                                    th Thời gian
                            tbody#latest-orders
                                each order in latestOrders
                                    if order.status == "Đang xử lí"|| order.status == "Đang giao hàng"
                                        tr
                                            td.fw-bold= order.id
                                            td.fw-bold= order.customer
                                            td.fw-bold #{order.total.toLocaleString()} $
                                            td.fw-bold
                                                button(
                                                    class="btn btn-success" 
                                                    button-change-status-order=(order.status=="Đang xử lí"?"Đang giao hàng":"Hoàn thành")
                                                    data-id=order.id
                                                ) #{order.status}
                                            td.fw-bold= new Date(order.time).toLocaleString()

            .col-lg-4
                .card.mb-3
                    .card-body
                        h5.card-title Hành động nhanh
                        .d-grid.gap-2
                            a(href="/admin/products/create" class="btn btn-success btn-sm") Thêm sản phẩm
                            a(href="/admin/order" class="btn btn-primary btn-sm") Xem tất cả đơn hàng

                .card.mb-3
                    .card-body
                        h5.card-title Sản phẩm gần hết hàng
                        if lowStockProducts.length
                            table.table.table-sm.table-bordered
                                thead
                                    tr
                                        th Tên sản phẩm
                                        th Số lượng 
                                tbody
                                    each product in lowStockProducts
                                        tr
                                            td= product.title
                                            td.text-danger.fw-bold= product.stock
                        else
                            p.text-muted Không có sản phẩm nào gần hết hàng