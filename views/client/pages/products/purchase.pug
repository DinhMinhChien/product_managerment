extends ../../layouts/default.pug

block main 
    .container.my-5
    h1.mb-4.ps-3= pageTitle 
    .row
        .col-lg-8
            form(
                action=`/products/order-success/${product.id}/${quantity}`
                method="POST"
                class="p-4 p-lg-5 rounded-4 shadow-sm bg-white mb-4"
                style="border:1px solid #e3e3e3;"
            )
                h2.mb-4.fw-bold.text-success(style="font-size:1.45rem;") 🛒 Thông tin Giao hàng

                .mb-3
                    label.form-label.fw-semibold(for="name") Họ và tên
                    input.form-control.form-control-lg(
                        type="text"
                        id="name"
                        name="name"
                        placeholder="Nhập họ và tên của bạn"
                        required
                    )

                .mb-3
                    label.form-label.fw-semibold(for="address") Địa chỉ giao hàng
                    textarea.form-control.form-control-lg(
                        id="address"
                        name="address"
                        rows="3"
                        placeholder="Ví dụ: 123 Lê Lợi, Quận 1, TP. HCM"
                        required
                    )

                hr.my-4

                h2.mb-3.fw-bold.text-success(style="font-size:1.45rem;") 💳 Hình thức Thanh toán

                .form-check.form-check-lg.mb-3.p-2.rounded(
                    style="background:#f8f9fa; border:1px solid #e1e1e1;"
                )
                    input.form-check-input(
                        type="radio"
                        name="payment_method"
                        id="payment_cod"
                        value="cod"
                        checked
                    )
                    label.form-check-label.fw-semibold.ms-2(for="payment_cod")
                        | Thanh toán khi nhận hàng (COD)
                .form-check.form-check-lg.mb-3.p-2.rounded(
                    style="background:#f8f9fa; border:1px solid #e1e1e1;"
                )
                    input.form-check-input(
                        type="radio"
                        name="payment_method"
                        id="payment_transfer"
                        value="bank_transfer"
                    )
                    label.form-check-label.fw-semibold.ms-2(for="payment_transfer")
                        | Chuyển khoản Ngân hàng

                .form-check.form-check-lg.mb-3.p-2.rounded(
                    style="background:#f8f9fa; border:1px solid #e1e1e1;"
                )
                    input.form-check-input(
                        type="radio"
                        name="payment_method"
                        id="payment_card"
                        value="credit_card"
                    )
                    label.form-check-label.fw-semibold.ms-2(for="payment_card")
                        | Thanh toán bằng Thẻ tín dụng/ghi nợ

                button.btn.btn-success.btn-lg.w-100.mt-4.py-3.fw-bold(
                    type="submit"
                    style="font-size:1.2rem; border-radius:12px;"
                )
                    | Xác nhận Thanh toán
        .col-lg-4
            .card.shadow-sm
                .card-header.bg-primary.text-white
                    h4.m-0 Tóm tắt Đơn hàng
                .card-body
                    .text-center.mb-3
                        img(src=product.thumbnail, alt="Hình ảnh sản phẩm", style="width: 100px; height: 100px; object-fit: cover; border-radius: 8px;")
                    .d-flex.justify-content-between.align-items-center.mb-4
                        h5.m-0.text-dark Tổng cộng:
                        h2.text-danger.m-0 
                            span= totalPrice
                            | $
                    
                    p.text-muted.small Lưu ý: Giá trị trên chưa bao gồm thuế (VAT).
