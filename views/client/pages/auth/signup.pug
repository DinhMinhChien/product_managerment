extends ../../layouts/auth.pug
block main
    .signup-container
        .signup-box
            h1.logo VietShop
            h2 Tạo Tài Khoản Mới
            
            form(action='/signup', method='POST')
                div(class="input-group")
                    label(for='fullName') Tên người dùng
                    input(type='text', id='fullName', name='fullName', placeholder='Nhập tên người dùng', required)
                    
                div(class="input-group")
                    label(for='email') Địa chỉ Email
                    input(type='email', id='email', name='email', placeholder='Ví dụ: ban@example.com', required)
                div(class="input-group")
                    label(for='phone') Số điện thoại
                    input(type='phone', id='phone', name='phone', placeholder='Tối thiểu 8 ký tự', required)
                div(class="input-group")
                    label(for='password') Mật khẩu
                    input(type='password', id='password', name='password', placeholder='Tối thiểu 8 ký tự', required)
                div(class="terms-checkbox")
                    input(type='checkbox', id='terms', name='terms', required)
                    label(for='terms')
                        | Tôi đồng ý với 
                        a(href='#') Điều khoản Dịch vụ
                
                button.signup-btn(type='submit') Đăng Ký Ngay
                
            div(class="login-link")
                | Bạn đã có tài khoản? 
                a(href='#') Đăng nhập tại đây